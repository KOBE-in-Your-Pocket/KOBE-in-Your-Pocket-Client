# Google Maps API キー（Android の地図タイル表示に必要）
#
# GCP プロジェクト: KOBE-in-Your-Poket（プロジェクト ID: kobe-in-your-poket）
#
# セットアップ手順:
# 1. https://console.cloud.google.com/ でプロジェクト「KOBE-in-Your-Poket」を選択
# 2. 「Maps SDK for Android」を有効化
# 3. 認証情報 → API キーを作成
# 4. Android キー制限: パッケージ名 com.kobeinyourpocket.client + デバッグ SHA-1
#    SHA-1 確認（Expo / RN の debug keystore）:
#    keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android -keypass android
# 5. このファイルを .env にコピーしてキーを設定
# 6. pnpm android を実行（初回は Dev Client ビルド、2 回目以降は Metro 起動）
GOOGLE_MAPS_API_KEY=

# OpenRouteService API キー（マップ上の道なり経路表示に使用）
#
# 現在地 → 観光スポットの徒歩経路を取得するために使う。GCP 不要・クレジットカード不要。
#
# セットアップ手順:
# 1. https://openrouteservice.org/dev/#/signup で無料アカウントを作成
# 2. ダッシュボードで Token（API キー）を発行（無料プラン: 2000 リクエスト/日）
# 3. このファイルを .env にコピーしてキーを設定
#
# 注意: EXPO_PUBLIC_ 接頭辞の変数はクライアント JS に埋め込まれる（端末から閲覧可能）。
#       学習用途では許容範囲だが、本番ではサーバ経由での取得を検討すること。
EXPO_PUBLIC_OPENROUTESERVICE_API_KEY=

# S3 観光スポット画像のベース URL（未設定時は Unsplash プレースホルダーを使用）
# セットアップ: リポジトリ外 infrastructure/aws/README.md を参照
# 例: https://<bucket>.s3.ap-northeast-1.amazonaws.com
EXPO_PUBLIC_S3_IMAGE_BASE_URL=

# バックエンド REST API のベース URL（Google サインインなどの認証 API にも使用）
#
# 未設定時は各 feature のモック実装で動作する。
# ローカル開発では backend（別リポジトリ）を起動し、環境に応じて以下を設定する:
# - iOS シミュレータ: http://localhost:9090
# - Android エミュレータ: http://10.0.2.2:9090（ホスト機を指す）
# - 実機: Mac の LAN IP を指定（例: http://192.168.1.10:9090）。localhost は端末から届かない。
# - デプロイ環境: https://18-181-34-28.sslip.io（Backend の HTTPS 化により平文 HTTP から移行）
#   ネイティブアプリは CORS の制約を受けないため、この HTTPS オリジンを直接指定できる。
#   HTTPS なので iOS ATS / Android cleartext の例外は不要。ホスト名は IP 用の暫定名で、
#   独自ドメイン取得後はこの値を差し替える。
# ローカル HTTP backend を使う場合のみ ATS 例外が必要（開発ビルド時に app.config.ts が設定）。
# backend のデフォルトポートは 9090（ローカル HTTP のとき）。
EXPO_PUBLIC_API_BASE_URL=

# Google サインイン用の iOS クライアント ID（GCP の OAuth クライアント、種別 iOS）
#
# ローカル dev build（LOCAL_DEV_IOS=1）では Bundle ID com.kobeinyourpocket.client.dev で
# 発行したクライアント ID を使うこと。
# EAS / 本番 Bundle ID（com.kobeinyourpocket.client）向けビルドでは、その Bundle ID で
# 発行したクライアント ID を使うこと。
# 形式: 数字-ランダム文字列.apps.googleusercontent.com
# iOS の URL スキーム（逆順クライアント ID）は app.config.ts がこの値から導出するため
# 別途設定は不要。ネイティブビルド時に必要なので、変更したら dev client を作り直すこと。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google サインイン用の Web クライアント ID（GCP の OAuth クライアント、種別ウェブアプリケーション）
#
# Android で idToken を取得するために必須。iOS では未使用（iosClientId を使う）。
# あわせて GCP に種別 Android の OAuth クライアントを作成し、
# パッケージ名 com.kobeinyourpocket.client + デバッグ / EAS の SHA-1 を登録すること
# （Android クライアント ID 自体は JS には埋め込まない）。
# Supabase Authentication → Google → Client IDs には、iOS / Web の ID をカンマ区切りで追加する。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
